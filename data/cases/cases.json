  {
    "id": "case-dka",
    "title": "Adolescent with type 1 diabetes — diabetic ketoacidosis",
    "clinicalCategory": "Physiological Adaptation",
    "origin": "original",
    "scenario": "The nurse is caring for a 15-year-old client with type 1 diabetes mellitus who was brought to the emergency department by a parent.",
    "totalParts": 6,
    "records": [
      {
        "id": "notes",
        "label": "Nurses' Notes",
        "blocks": [
          {
            "kind": "entries",
            "entries": [
              {
                "time": "14:00",
                "text": "Parent reports the client's insulin pump tubing became dislodged at some point yesterday and the client has vomited 4 times since last evening. Client is drowsy but answers questions appropriately. Respirations deep and rapid with a fruity odour to the breath. Mucous membranes dry and sticky. Skin warm. Abdomen soft, generalised tenderness, pain 3/10. Breath sounds clear bilaterally. Weight 54 kg; usual weight 56 kg."
              },
              {
                "time": "18:00",
                "fromPart": 5,
                "text": "Received 0.9% sodium chloride bolus and maintenance fluids; IV regular insulin infusion running since 15:30. Client more alert. Urine output last 4 hours 260 mL (1.2 mL/kg/hour). Respirations less deep. No vomiting since arrival."
              },
              {
                "time": "Day 2, 06:00",
                "fromPart": 6,
                "text": "Client alert and asking for breakfast. Respirations regular and unlaboured. Weight 55.5 kg. Abdominal pain 3/10, unchanged. At 05:40 the client reported a severe headache that began about 30 minutes earlier."
              }
            ]
          }
        ]
      },
