                ]
              },
              {
                "cells": [
                  "Point-of-care blood glucose every hour"
                ]
              },
              {
                "cells": [
                  "Electrolytes and venous blood gas every 2–4 hours"
                ]
              },
              {
                "cells": [
                  "NPO except ice chips"
                ]
              },
              {
                "cells": [
                  "Continuous cardiac monitoring"
                ]
              },
              {
                "fromPart": 5,
                "cells": [
                  "When blood glucose is 300 mg/dL or less, change IV fluid to dextrose 5% in 0.45% sodium chloride"
                ]
              },
              {
                "fromPart": 5,
                "cells": [
                  "Add potassium chloride 20 mEq/L to IV fluids when serum potassium is less than 5.0 mEq/L and urine output is at least 1 mL/kg/hour"
                ]
              }
            ]
          }
