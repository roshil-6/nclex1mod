  {
    "id": "case-hf-dig",
    "title": "Older adult with heart failure — digoxin toxicity",
    "clinicalCategory": "Pharmacological Therapies",
    "origin": "original",
    "scenario": "The nurse is caring for a 78-year-old client admitted to the medical unit from the emergency department.",
    "totalParts": 6,
    "records": [
      {
        "id": "hp",
        "label": "History and Physical",
        "blocks": [
          {
            "kind": "text",
            "heading": "History",
            "paragraphs": [
              "Heart failure with reduced ejection fraction (ejection fraction 30%). Permanent atrial fibrillation. Chronic kidney disease stage 3. Lives alone; daughter visits daily.",
              "Home medications: digoxin 0.25 mg orally daily, furosemide 40 mg orally twice daily, metoprolol succinate 25 mg orally daily, lisinopril 5 mg orally daily."
            ]
          },
          {
            "kind": "text",
            "heading": "Presenting problem",
            "paragraphs": [
              "Four days of nausea, poor appetite and fatigue. Daughter reports the client has been \"seeing yellow-green rings around lights\" since yesterday."
            ]
          }
        ]
      },
      {
        "id": "notes",
        "label": "Nurses' Notes",
        "blocks": [
          {
            "kind": "entries",
            "entries": [
              {
                "time": "Day 1, 12:00",
                "text": "Admitted to unit. Alert and oriented, fatigued. Reports nausea and has eaten very little for 4 days. States lights in the room \"have yellow halos.\" Apical pulse 52/min, irregular. Fine crackles in both lung bases. 1+ pitting oedema of both ankles. Weight 61.2 kg (dry weight per clinic record 61.0 kg)."
              },
              {
                "time": "Day 1, 14:20",
                "fromPart": 4,
                "text": "Client reports feeling \"very dizzy\" when sitting up. Telemetry: atrial fibrillation with ventricular rate 40–44/min. Blood pressure 86/50 mm Hg. Skin cool. Client returned to bed; rapid response team called."
              },
              {
                "time": "Day 3, 08:00",
                "fromPart": 6,
                "text": "Nausea resolved; ate 75% of breakfast. Denies visual changes. Apical pulse 68/min, irregular. Crackles now present to mid-lung fields bilaterally; client reports needing 3 pillows to sleep last night. Weight 63.3 kg."
              }
            ]
          }
        ]
